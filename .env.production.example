# Production settings for docker-compose.prod.yml.
# Copy to .env on the server and fill in every CHANGE_ME.
# Never commit the real .env.

# --- Public address -----------------------------------------------------------
# Your DuckDNS subdomain (no https://). Use "localhost" for a local test.
SITE_ADDRESS=CHANGE_ME.duckdns.org
APP_URL=https://CHANGE_ME.duckdns.org

# Image to run. Locally it is built from the Dockerfile; on the server it is
# pulled from GitHub Container Registry.
APP_IMAGE=deltasocial:local

# --- Laravel ------------------------------------------------------------------
APP_NAME=DeltaSocialMedia
APP_ENV=production
APP_DEBUG=false
# Generate with: docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=CHANGE_ME
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (MySQL container) -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=deltasocial
DB_USERNAME=deltasocial
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# --- Redis (cache, sessions, queue) -------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

# --- Files --------------------------------------------------------------------
FILESYSTEM_DISK=local

# --- Reverb (WebSockets) ------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
# How Laravel (server side) reaches Reverb: directly over the Docker network.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Browsers connect via Caddy at wss://SITE_ADDRESS/app (baked in at build time).

# --- Mail ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
